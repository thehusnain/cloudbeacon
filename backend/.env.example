PORT=5000
# Match the credentials configured in the root docker-compose.yml.
MONGO_URI=mongodb://cbadmin:YOUR_MONGO_PASSWORD@127.0.0.1:27017/cloud-beacon?authSource=admin
# Required: generate a secret with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Exact browser origin, without a trailing slash.
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Shared register/login requests per IP per 15 minutes; 0 disables this limiter.
AUTH_RATE_LIMIT_MAX=10
