        {
          "name": "Delete server",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/servers/{{serverId}}",
            "description": "Deletes this server. Run only when finished with it.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
