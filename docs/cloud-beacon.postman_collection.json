      ]
    },
    {
      "name": "Agent",
      "item": [
        {
          "name": "Enroll",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agent/enroll",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{enrollmentKey}}\",\n  \"hostname\": \"example-server\",\n  \"os\": \"Ubuntu 24.04\",\n  \"ip\": \"203.0.113.10\",\n  \"agentVersion\": \"0.1.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"agentToken\", data.agentToken);",
                  "  pm.collectionVariables.set(\"serverId\", data.serverId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agent/heartbeat",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"agentVersion\": \"0.1.0\",\n  \"stats\": {\n    \"cpuPercent\": 1,\n    \"memoryMb\": 24,\n    \"bufferedEvents\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Ingest events",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agent/events",
            "description": "Maximum 500 events. Keep eventId unchanged when testing resends; the example generates a fresh UUID for each send.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"eventId\": \"{{$guid}}\",\n      \"type\": \"ssh_failed_login\",\n      \"severity\": \"medium\",\n      \"sourceIp\": \"198.51.100.7\",\n      \"timestamp\": \"{{$isoTimestamp}}\",\n      \"details\": {\n        \"user\": \"root\",\n        \"port\": 22,\n        \"method\": \"password\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/agent/rules",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Report command result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agent/commands/{{commandId}}/result",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\",\n  \"message\": \"Command completed\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
