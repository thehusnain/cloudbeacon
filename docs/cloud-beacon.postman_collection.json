            ],
            "url": "{{baseUrl}}/servers",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example server\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"serverId\", data.server.id);",
                  "  pm.collectionVariables.set(\"enrollmentKey\", data.enrollmentKey);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List servers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/servers",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get server",
          "request": {
            "method": "GET",
